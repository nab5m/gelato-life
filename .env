# 로컬 개발 기본값 (비밀 아님). Prisma CLI 와 Next.js 가 함께 읽는다.
# 실제 시크릿(파트너 자격증명, webhook secret 등)은 .env.local 에 둔다.
DATABASE_URL=postgresql://gelato:gelato@localhost:5432/gelato_life?schema=public
# 로컬은 풀링이 없어 직결 URL 도 동일. Supabase 사용 시 .env.local 에서 둘 다 override.
DIRECT_URL=postgresql://gelato:gelato@localhost:5432/gelato_life?schema=public
