# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채운다. (.env.local 은 git 에 올라가지 않음)
#
#   cp .env.local.example .env.local
#
# 참고: DATABASE_URL 은 로컬 기본값이라 .env 에 두었다(커밋됨). 운영 DB 는 .env.local 에서 override.

# --- 플라트라이프 파트너 오픈 API ---
# 오픈 API base URL (끝 슬래시 없이)
PARTNER_API_BASE_URL=https://api.plott.life
# client credentials — 매 요청 Basic 인증에 사용 (별도 토큰 발급 없음)
PARTNER_OAUTH_CLIENT_ID=your-client-id
PARTNER_OAUTH_CLIENT_SECRET=your-client-secret
# 선택: 이미지 CDN 베이스 (미설정 시 https://cdn.dev.plott.co.kr)
# PARTNER_CDN_BASE_URL=https://cdn.dev.plott.co.kr

# --- 계약 webhook ---
# 플라트라이프에 등록한 webhook 시크릿과 동일하게 설정
PLOTT_WEBHOOK_SECRET=change-me

# --- 인증(세션 쿠키 서명) ---
# 운영에선 반드시 무작위 긴 값으로 교체
AUTH_SECRET=change-me-to-a-long-random-string

# --- Google Maps ---
# 브라우저에 노출되는 키이므로 Google Cloud 콘솔에서 HTTP 리퍼러/ API 제한 권장
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 운영 DB 를 쓸 경우 (.env 의 로컬 기본값 override)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
